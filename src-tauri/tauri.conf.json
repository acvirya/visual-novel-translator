{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "visual-novel-translator",
  "version": "0.1.0",
  "identifier": "com.visualnoveltranslator.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Visual Novel Translator",
        "width": 960,
        "height": 680
      },
      {
        "label": "overlay",
        "title": "VN Translator Overlay",
        "url": "index.html?overlay=true",
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "visible": false,
        "contentProtected": true,
        "resizable": true,
        "skipTaskbar": true
      },
      {
        "label": "region-selector",
        "title": "OCR Screen Region Selector",
        "url": "index.html?regionSelector=true",
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "visible": false,
        "contentProtected": true,
        "resizable": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
