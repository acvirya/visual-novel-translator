{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "visual-novel-translator",
  "version": "0.1.0",
  "identifier": "com.visualnoveltranslator.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Visual Novel Translator",
        "width": 1050,
        "height": 720,
        "minWidth": 620,
        "minHeight": 480
      },
      {
        "label": "overlay",
        "title": "VN Translator Overlay",
        "url": "index.html?overlay=true",
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "visible": false,
        "contentProtected": true,
        "resizable": true,
        "skipTaskbar": true
      },
      {
        "label": "region-selector",
        "title": "OCR Screen Region Selector",
        "url": "index.html?regionSelector=true",
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "visible": false,
        "contentProtected": true,
        "resizable": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri:; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: tauri:; connect-src 'self' https: ipc: http://ipc.localhost tauri:; frame-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none';",
      "devCsp": "default-src 'self' tauri:; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: tauri:; connect-src 'self' https: ipc: http://ipc.localhost tauri: ws://localhost:1421 ws://127.0.0.1:1421; frame-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
