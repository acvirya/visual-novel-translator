{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "opener:default",
    "global-shortcut:default",
    "global-shortcut:allow-unregister-all",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-register",
    "global-shortcut:allow-is-registered",
    "allow-get-monitors",
    "allow-get-window-monitor",
    "allow-show-overlay",
    "allow-hide-overlay",
    "allow-update-overlay-bounds",
    "allow-set-overlay-click-through",
    "allow-set-overlay-edit-mode",
    "allow-open-region-selector-overlay",
    "allow-close-region-selector-overlay",
    "allow-list-target-processes",
    "allow-start-textractor",
    "allow-send-textractor-command",
    "allow-stop-textractor",
    "allow-find-textractor-installation",
    "allow-detect-oneocr-path",
    "allow-capture-regions-preview",
    "allow-run-oneocr-scan",
    "allow-translate-free-mt",
    "allow-show-save-script-dialog",
    "allow-show-open-script-dialog",
    "allow-save-script-file",
    "allow-read-script-file-by-path",
    "allow-show-pick-files-dialog",
    "allow-show-pick-directory-dialog",
    "allow-append-debug-log",
    "allow-read-debug-log",
    "allow-clear-debug-log",
    "allow-open-file-in-default-app",
    "allow-load-app-settings",
    "allow-save-app-settings",
    "allow-openrouter-chat-completion",
    "allow-openrouter-stream-chat-completion",
    "allow-llm-chat-completion",
    "allow-llm-stream-chat-completion",
    "allow-test-llm-connection",
    "allow-cancel-all-llm-streams",
    "allow-cancel-llm-stream",
    "allow-get-secure-key",
    "allow-set-secure-key",
    "allow-delete-secure-key"
  ]
}
